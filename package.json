{
  "name": "factory-sample-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:integration": "npm run test:integration --workspaces",
    "build": "npm run build --workspaces",
    "db:up": "docker compose up -d db",
    "demo": "concurrently -k -n backend,frontend \"npm run dev -w backend\" \"npm run dev -w frontend\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.2",
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=22"
  }
}
